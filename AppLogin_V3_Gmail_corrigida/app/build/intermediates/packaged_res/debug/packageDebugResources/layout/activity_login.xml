<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Entrar"
            android:textSize="40sp"
            android:textStyle="bold"
            android:layout_marginTop="50dp"
            android:layout_marginBottom="36dp"/>

        <EditText
            android:id="@+id/edtUsuarioLogin"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:hint="Usuário"
            android:inputType="text"
            android:layout_marginBottom="16dp"/>

        <EditText
            android:id="@+id/edtSenhaLogin"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:hint="Senha ou código de 6 dígitos"
            android:inputType="textPassword"
            android:drawableEnd="@drawable/ic_visibility"
            android:drawablePadding="8dp"
            android:paddingEnd="8dp"
            android:layout_marginBottom="16dp"/>

        <Button android:id="@+id/btnLogin" android:layout_width="240dp" android:layout_height="wrap_content" android:text="Entrar"/>
        <Button android:id="@+id/btnEsqueciSenha" android:layout_width="240dp" android:layout_height="wrap_content" android:text="Esqueci minha senha" android:layout_marginTop="8dp"/>
        <Button android:id="@+id/btnCadastro" android:layout_width="240dp" android:layout_height="wrap_content" android:text="Criar cadastro" android:layout_marginTop="8dp"/>
    </LinearLayout>
</ScrollView>
